<Window x:Class="TdrSim.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nodify="https://miroiu.github.io/nodify"
        xmlns:plot="clr-namespace:TdrSim.App.Plot"
        xmlns:editor="clr-namespace:TdrSim.App.Editor"
        xmlns:shell="clr-namespace:TdrSim.App.Shell"
        Title="{Binding Title}"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterScreen"
        Closing="OnWindowClosing">
    <Window.InputBindings>
        <!-- Note: a focused TextBox consumes Ctrl+Z for its own text undo first. -->
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Hands the shell view model to bindings outside the visual tree (the
             Recent menu's CompositeCollection). -->
        <shell:BindingProxy x:Key="ShellProxy" Data="{Binding}" />

        <DataTemplate x:Key="InputPortTemplate" DataType="{x:Type editor:PortViewModel}">
            <nodify:NodeInput Header="{Binding Label}"
                              IsConnected="{Binding IsConnected}"
                              Anchor="{Binding Anchor, Mode=OneWayToSource}" />
        </DataTemplate>
        <DataTemplate x:Key="OutputPortTemplate" DataType="{x:Type editor:PortViewModel}">
            <nodify:NodeOutput Header="{Binding Label}"
                               IsConnected="{Binding IsConnected}"
                               Anchor="{Binding Anchor, Mode=OneWayToSource}" />
        </DataTemplate>

        <!-- A square of the component bar: icon above, subtitle below. -->
        <Style x:Key="PaletteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="#DDD" />
            <Setter Property="Background" Value="#3E3E42" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#505056" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#007ACC" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#007ACC" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InspectorHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#EEE" />
        </Style>
        <Style x:Key="InspectorLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2" />
            <Setter Property="Foreground" Value="#AAA" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="InspectorNote" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Foreground" Value="#777" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel Background="#2D2D30">

        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="#333337" Padding="6,4">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="New" Command="{Binding NewCommand}" Margin="2,0" Padding="10,3" />
                    <Button Content="Open…" Command="{Binding OpenCommand}" Margin="2,0" Padding="10,3" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Margin="2,0" Padding="10,3" />
                    <Button Content="Save As…" Command="{Binding SaveAsCommand}" Margin="2,0" Padding="10,3" />
                    <Menu VerticalAlignment="Center"
                          Background="Transparent"
                          Margin="2,0">
                        <MenuItem Header="Examples ▾"
                                  Padding="10,3"
                                  Foreground="#DDD"
                                  ItemsSource="{Binding Examples}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                    <Setter Property="Foreground" Value="#1E1E1E" />
                                    <Setter Property="Command"
                                            Value="{Binding DataContext.OpenExampleCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <!-- Recent files (MRU first) plus the reopen-at-startup toggle;
                             both persist in the app settings. -->
                        <MenuItem Header="Recent ▾"
                                  Padding="10,3"
                                  Foreground="#DDD">
                            <MenuItem.ItemContainerStyleSelector>
                                <shell:RecentMenuStyleSelector>
                                    <shell:RecentMenuStyleSelector.FileStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="ToolTip" Value="{Binding Path}" />
                                            <Setter Property="Foreground" Value="#1E1E1E" />
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.OpenRecentCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </shell:RecentMenuStyleSelector.FileStyle>
                                </shell:RecentMenuStyleSelector>
                            </MenuItem.ItemContainerStyleSelector>
                            <MenuItem.ItemsSource>
                                <CompositeCollection>
                                    <CollectionContainer
                                        Collection="{Binding Data.RecentFiles, Source={StaticResource ShellProxy}}" />
                                    <Separator />
                                    <MenuItem Header="Reopen last project at startup"
                                              IsCheckable="True"
                                              IsChecked="{Binding Data.ReopenLastFile, Source={StaticResource ShellProxy}}"
                                              Foreground="#1E1E1E" />
                                </CompositeCollection>
                            </MenuItem.ItemsSource>
                        </MenuItem>
                    </Menu>
                    <Border Width="1" Background="#555" Margin="8,2" />
                    <Button Content="↶ Undo" Command="{Binding UndoCommand}" Margin="2,0" Padding="8,3" />
                    <Button Content="↷ Redo" Command="{Binding RedoCommand}" Margin="2,0" Padding="8,3" />
                    <Border Width="1" Background="#555" Margin="8,2" />
                    <ToggleButton Content="● Live"
                                  IsChecked="{Binding IsLive}"
                                  FontWeight="Bold"
                                  Margin="2,0"
                                  Padding="12,3"
                                  ToolTip="Recompute the trace on every edit" />
                    <Button Content="⟳ Refresh"
                            Command="{Binding RefreshCommand}"
                            Margin="2,0"
                            Padding="12,3"
                            ToolTip="Force one full-resolution run" />
                    <Border Width="1" Background="#555" Margin="8,2" />
                    <TextBlock Text="instrument"
                               Foreground="#888"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="4,0,4,0" />
                    <ComboBox Width="150"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Instrument.Presets}"
                              SelectedItem="{Binding Instrument.SelectedPreset}"
                              DisplayMemberPath="Name" />
                    <TextBlock Text="rise"
                               Foreground="#888"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="10,0,4,0" />
                    <Slider Width="130"
                            Minimum="1"
                            Maximum="3.69897"
                            Value="{Binding Instrument.RiseTimeLog}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Rise time" />
                    <TextBlock Text="{Binding Instrument.EffectiveRiseTimePs, StringFormat={}{0:0.#} ps}"
                               Foreground="#DDD"
                               FontSize="11"
                               VerticalAlignment="Center"
                               MinWidth="46"
                               Margin="6,0,0,0" />
                    <Button Content="×"
                            Command="{Binding Instrument.ClearRiseTimeOverrideCommand}"
                            Padding="6,0"
                            Margin="2,0"
                            ToolTip="Clear the rise-time override (back to the preset)" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Badges}"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="9" Padding="9,2" Margin="3,0" ToolTip="{Binding Tooltip}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#8C6D1F" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFatal}" Value="True">
                                                <Setter Property="Background" Value="#A33A3A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                                <Setter Property="Background" Value="#2E5C8A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- status line -->
        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="8,2">
            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12" />
        </Border>

        <!-- component bar: one square button per kind of thing to add -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1"
                Padding="6,5">
            <ItemsControl ItemsSource="{Binding Palette.Buttons}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type editor:PaletteButton}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="1"
                                    Background="#555"
                                    Margin="8,6"
                                    Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource PaletteButtonStyle}"
                                    Click="OnPaletteButtonClick"
                                    ContextMenuOpening="OnPaletteContextMenuOpening"
                                    ToolTip="{Binding ToolTip}"
                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                    AutomationProperties.Name="{Binding Title}">
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding Entries}"
                                                 MenuItem.Click="OnPaletteMenuItemClick">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Label}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="MenuItem">
                                                                    <Border BorderBrush="#C8C8C8"
                                                                            BorderThickness="0,0,0,1"
                                                                            Margin="6,6,6,2"
                                                                            Padding="0,0,0,2">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   FontWeight="Bold"
                                                                                   FontSize="11"
                                                                                   Foreground="#555" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel>
                                    <Path Data="{Binding Icon}"
                                          Width="32"
                                          Height="32"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="10.5"
                                               Margin="0,4,0,0"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineStackingStrategy="BlockLineHeight"
                                               LineHeight="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- top half: canvas | inspector; bottom half: TDR trace | pulse view.
             Both dividers drag. -->
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <GridSplitter Grid.Row="1"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeDirection="Rows"
                      Background="#3F3F46"
                      Cursor="SizeNS"
                      ToolTip="Drag to resize the canvas and the plots"
                      AutomationProperties.AutomationId="PlotsSplitter" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <TabControl Grid.Column="0"
                        Background="#2D2D30"
                        BorderThickness="0"
                        SelectedIndex="{Binding ActiveViewIndex}">
                <TabItem Header="TDR trace">
                    <plot:TracePanel DataContext="{Binding TracePanel}" />
                </TabItem>
                <TabItem Header="Bounce diagram">
                    <plot:BouncePanel DataContext="{Binding Bounce}" />
                </TabItem>
                <TabItem Header="Return loss">
                    <plot:ReturnLossPanel DataContext="{Binding ReturnLossView}" />
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          Background="#3F3F46"
                          Cursor="SizeWE"
                          ToolTip="Drag to resize the trace and the pulse view"
                          AutomationProperties.AutomationId="TracePulseSplitter" />
            <TabControl Grid.Column="2"
                        Background="#2D2D30"
                        BorderThickness="0">
                <TabItem Header="Pulse view">
                    <plot:PulsePanel DataContext="{Binding Pulse}" />
                </TabItem>
            </TabControl>
        </Grid>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- canvas -->
            <nodify:NodifyEditor x:Name="EditorCanvas"
                                 Grid.Column="0"
                                 Background="#1E1E1E"
                                 ItemsSource="{Binding Editor.Nodes}"
                                 Connections="{Binding Editor.Connections}"
                                 SelectedItems="{Binding Editor.SelectedNodes}"
                                 PendingConnection="{Binding Editor.PendingConnection}"
                                 DisconnectConnectorCommand="{Binding Editor.DisconnectPortCommand}">
                <nodify:NodifyEditor.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding Editor.DeleteSelectionCommand}" />
                </nodify:NodifyEditor.InputBindings>

                <nodify:NodifyEditor.Resources>
                    <!-- node templates scoped to the canvas so the inspector can use its own -->
                    <DataTemplate DataType="{x:Type editor:TdrNodeViewModel}">
                        <nodify:Node Header="{Binding Title}"
                                     Output="{Binding OutputPorts}"
                                     OutputConnectorTemplate="{StaticResource OutputPortTemplate}" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type editor:CableNodeViewModel}">
                        <nodify:Node Header="{Binding Title}"
                                     Input="{Binding InputPorts}"
                                     Output="{Binding OutputPorts}"
                                     InputConnectorTemplate="{StaticResource InputPortTemplate}"
                                     OutputConnectorTemplate="{StaticResource OutputPortTemplate}" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type editor:ConnectorNodeViewModel}">
                        <nodify:Node Header="{Binding Title}"
                                     Input="{Binding InputPorts}"
                                     Output="{Binding OutputPorts}"
                                     InputConnectorTemplate="{StaticResource InputPortTemplate}"
                                     OutputConnectorTemplate="{StaticResource OutputPortTemplate}" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type editor:LoadNodeViewModel}">
                        <nodify:Node Header="{Binding Title}"
                                     Input="{Binding InputPorts}"
                                     InputConnectorTemplate="{StaticResource InputPortTemplate}" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type editor:JunctionNodeViewModel}">
                        <nodify:Node Header="{Binding Title}"
                                     Input="{Binding InputPorts}"
                                     InputConnectorTemplate="{StaticResource InputPortTemplate}" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type editor:FaultNodeViewModel}">
                        <nodify:Node Header="{Binding Title}"
                                     Input="{Binding InputPorts}"
                                     Output="{Binding OutputPorts}"
                                     InputConnectorTemplate="{StaticResource InputPortTemplate}"
                                     OutputConnectorTemplate="{StaticResource OutputPortTemplate}" />
                    </DataTemplate>
                </nodify:NodifyEditor.Resources>

                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <!-- hover shades this node's stretch of the trace -->
                        <EventSetter Event="MouseEnter" Handler="OnNodeMouseEnter" />
                        <EventSetter Event="MouseLeave" Handler="OnNodeMouseLeave" />
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnNodeMouseDown" />
                        <Style.Triggers>
                            <!-- the trace (or a bounce ray) is pointing at this node -->
                            <DataTrigger Binding="{Binding IsTraceHighlighted}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#39FF9E"
                                                          BlurRadius="22"
                                                          ShadowDepth="0"
                                                          Opacity="1" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>

                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type editor:ConnectionViewModel}">
                        <!-- Bezier, not a straight line: connections render UNDER the
                             nodes, and port circles sit inside the node body, so a
                             straight wire approaching from a steep angle tunnels behind
                             the node and looks detached. The curve always leaves the
                             source rightward and enters the target from the left -
                             outside the node bodies - and Connect() normalizes wires
                             so the output end is the source. OffsetMode None keeps the
                             endpoints exactly on the circle centers. -->
                        <nodify:Connection Source="{Binding Source.Anchor}"
                                           Target="{Binding Target.Anchor}"
                                           SourceOffsetMode="None"
                                           TargetOffsetMode="None"
                                           DisconnectCommand="{Binding RemoveCommand}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>

                <nodify:NodifyEditor.PendingConnectionTemplate>
                    <DataTemplate DataType="{x:Type editor:PendingConnectionViewModel}">
                        <nodify:PendingConnection StartedCommand="{Binding StartCommand}"
                                                  CompletedCommand="{Binding FinishCommand}" />
                    </DataTemplate>
                </nodify:NodifyEditor.PendingConnectionTemplate>
            </nodify:NodifyEditor>

            <!-- one-touch view controls, floating over the canvas -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0">
                <Button Style="{StaticResource PaletteButtonStyle}"
                        Width="38" Height="38"
                        Focusable="False"
                        Click="OnCenterViewClick"
                        ToolTip="Center view: fit the whole network in the canvas"
                        AutomationProperties.AutomationId="CenterViewButton"
                        AutomationProperties.Name="Center view">
                    <Path Data="M 3,9 V 3 H 9 M 17,3 H 23 V 9 M 23,17 V 23 H 17 M 9,23 H 3 V 17 M 13,9 V 17 M 9,13 H 17"
                          Width="26" Height="26"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource PaletteButtonStyle}"
                        Width="38" Height="38"
                        Focusable="False"
                        Click="OnZoomInClick"
                        ToolTip="Zoom in"
                        AutomationProperties.AutomationId="ZoomInButton"
                        AutomationProperties.Name="Zoom in">
                    <Path Data="M 4,11 A 7,7 0 1 1 18,11 A 7,7 0 1 1 4,11 Z M 16,16 L 23,23 M 8,11 H 14 M 11,8 V 14"
                          Width="26" Height="26"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button Style="{StaticResource PaletteButtonStyle}"
                        Width="38" Height="38"
                        Focusable="False"
                        Click="OnZoomOutClick"
                        ToolTip="Zoom out"
                        AutomationProperties.AutomationId="ZoomOutButton"
                        AutomationProperties.Name="Zoom out">
                    <Path Data="M 4,11 A 7,7 0 1 1 18,11 A 7,7 0 1 1 4,11 Z M 16,16 L 23,23 M 8,11 H 14"
                          Width="26" Height="26"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
            </StackPanel>

            <!-- inspector -->
            <Border Grid.Column="1" Background="#252526">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl Content="{Binding InspectorContent}" Margin="12">
                        <ContentControl.Resources>

                            <DataTemplate DataType="{x:Type editor:CableNodeViewModel}">
                                <StackPanel>
                                    <TextBlock Text="Cable" Style="{StaticResource InspectorHeader}" />
                                    <TextBlock Text="Preset" Style="{StaticResource InspectorLabel}" />
                                    <ComboBox ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              DisplayMemberPath="Name" />
                                    <Button Content="Edit custom cable…"
                                            Visibility="{Binding IsCustomPreset, Converter={StaticResource BoolToVis}}"
                                            Click="OnEditCustomCableClick"
                                            Margin="0,4,0,0"
                                            Padding="6,2"
                                            HorizontalAlignment="Left" />
                                    <TextBlock Text="Length (m)" Style="{StaticResource InspectorLabel}" />
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right"
                                                 Width="64"
                                                 Text="{Binding LengthM, StringFormat={}{0:0.###}}" />
                                        <Slider Minimum="-1"
                                                Maximum="3"
                                                Value="{Binding LengthLog}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="Z0 (Ω)" Style="{StaticResource InspectorLabel}" />
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right"
                                                 Width="64"
                                                 AutomationProperties.Name="Z0"
                                                 Text="{Binding Z0Ohms, TargetNullValue=''}" />
                                        <Slider Minimum="1"
                                                Maximum="3"
                                                Value="{Binding Z0Log}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Z0 slider" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Z0DefaultNote}"
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="VF (0–1)" Style="{StaticResource InspectorLabel}" />
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right"
                                                 Width="64"
                                                 AutomationProperties.Name="VF"
                                                 Text="{Binding Vf, TargetNullValue=''}" />
                                        <Slider Minimum="0.1"
                                                Maximum="1"
                                                Value="{Binding VfSlider}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="VF slider" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding VfDefaultNote}"
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="Connector, end A" Style="{StaticResource InspectorLabel}" />
                                    <ComboBox AutomationProperties.Name="Connector A"
                                              ItemsSource="{Binding ConnectorChoiceList}"
                                              SelectedItem="{Binding SelectedConnectorA}"
                                              DisplayMemberPath="Label" />
                                    <TextBlock Text="Connector, end B" Style="{StaticResource InspectorLabel}" />
                                    <ComboBox AutomationProperties.Name="Connector B"
                                              ItemsSource="{Binding ConnectorChoiceList}"
                                              SelectedItem="{Binding SelectedConnectorB}"
                                              DisplayMemberPath="Label" />
                                    <TextBlock Text="{Binding ConnectorDefaultNote}"
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="Clear a box to return to the preset default."
                                               Style="{StaticResource InspectorNote}" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type editor:LoadNodeViewModel}">
                                <StackPanel>
                                    <TextBlock Text="Load" Style="{StaticResource InspectorHeader}" />
                                    <TextBlock Text="Kind" Style="{StaticResource InspectorLabel}" />
                                    <ComboBox ItemsSource="{Binding Kinds}"
                                              SelectedItem="{Binding LoadKind}" />
                                    <StackPanel Visibility="{Binding UsesR, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="R (Ω)" Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="R"
                                                     Text="{Binding ROhms, TargetNullValue=''}" />
                                            <Slider Minimum="-1"
                                                    Maximum="5"
                                                    Value="{Binding RLog}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="R slider" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding UsesL, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="L (nH)" Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="L"
                                                     Text="{Binding LNanohenries, TargetNullValue=''}" />
                                            <Slider Minimum="0"
                                                    Maximum="6"
                                                    Value="{Binding LLog}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="L slider" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding UsesC, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="C (pF)" Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="C"
                                                     Text="{Binding CPicofarads, TargetNullValue=''}" />
                                            <Slider Minimum="-1"
                                                    Maximum="6"
                                                    Value="{Binding CLog}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="C slider" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type editor:ConnectorNodeViewModel}">
                                <StackPanel>
                                    <TextBlock Text="Splice" Style="{StaticResource InspectorHeader}" />
                                    <TextBlock Text="Preset" Style="{StaticResource InspectorLabel}" />
                                    <ComboBox ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              DisplayMemberPath="Name" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type editor:JunctionNodeViewModel}">
                                <StackPanel>
                                    <TextBlock Text="Probe" Style="{StaticResource InspectorHeader}" />
                                    <TextBlock Text="Electrically invisible: everything wired to it becomes one node, and the pulse view can watch it."
                                               Style="{StaticResource InspectorNote}" />
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type editor:FaultNodeViewModel}">
                                <StackPanel>
                                    <TextBlock Text="Fault" Style="{StaticResource InspectorHeader}" />
                                    <StackPanel Visibility="{Binding IsSection, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Base cable" Style="{StaticResource InspectorLabel}" />
                                        <ComboBox ItemsSource="{Binding CablePresets}"
                                                  SelectedItem="{Binding SelectedBasePreset}"
                                                  DisplayMemberPath="Name" />
                                        <TextBlock Text="Section length (m)" Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="Section length"
                                                     Text="{Binding LengthM, TargetNullValue=''}" />
                                            <Slider Minimum="-2"
                                                    Maximum="3"
                                                    Value="{Binding LengthLog}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Section length slider" />
                                        </DockPanel>
                                        <TextBlock Text="Z0 scale" Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="Z0 scale"
                                                     Text="{Binding Z0Scale, TargetNullValue=''}" />
                                            <Slider Minimum="0.2"
                                                    Maximum="1.5"
                                                    Value="{Binding Z0ScaleSlider}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Z0 scale slider" />
                                        </DockPanel>
                                        <TextBlock Text="Extra dielectric loss (dB/100 m @ 100 MHz)"
                                                   Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="Extra loss"
                                                     Text="{Binding ExtraLossDbPer100m, TargetNullValue=''}" />
                                            <Slider Minimum="0"
                                                    Maximum="30"
                                                    Value="{Binding ExtraLossSlider}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Extra loss slider" />
                                        </DockPanel>
                                        <TextBlock Text="Z0 and velocity both scale (dielectric change at constant L)."
                                                   Style="{StaticResource InspectorNote}" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsBridge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Bridge resistance (Ω)" Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="Bridge resistance"
                                                     Text="{Binding ROhms, TargetNullValue=''}" />
                                            <Slider Minimum="-1"
                                                    Maximum="5"
                                                    Value="{Binding RLog}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Bridge resistance slider" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsSeries, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Series resistance (Ω)" Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="Series resistance"
                                                     Text="{Binding ROhms, TargetNullValue=''}" />
                                            <Slider Minimum="-1"
                                                    Maximum="5"
                                                    Value="{Binding RLog}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Series resistance slider" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type editor:TdrNodeViewModel}">
                                <ContentControl Content="{Binding Instrument}" />
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type editor:InstrumentViewModel}">
                                <StackPanel>
                                    <TextBlock Text="Instrument" Style="{StaticResource InspectorHeader}" />
                                    <TextBlock Text="Preset" Style="{StaticResource InspectorLabel}" />
                                    <ComboBox ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset}"
                                              DisplayMemberPath="Name" />
                                    <TextBlock Text="Rise time (ps)" Style="{StaticResource InspectorLabel}" />
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right"
                                                 Width="64"
                                                 AutomationProperties.Name="Rise time"
                                                 Text="{Binding RiseTimePs, TargetNullValue=''}" />
                                        <Slider Minimum="1"
                                                Maximum="3.69897"
                                                Value="{Binding RiseTimeLog}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Rise time slider" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding RiseTimeDefaultNote}"
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="Amplitude (V)" Style="{StaticResource InspectorLabel}" />
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right"
                                                 Width="64"
                                                 AutomationProperties.Name="Amplitude"
                                                 Text="{Binding AmplitudeVolts, TargetNullValue=''}" />
                                        <Slider Minimum="-1.30103"
                                                Maximum="0.69897"
                                                Value="{Binding AmplitudeLog}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Amplitude slider" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding AmplitudeDefaultNote}"
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="Source impedance (Ω)" Style="{StaticResource InspectorLabel}" />
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right"
                                                 Width="64"
                                                 AutomationProperties.Name="Source impedance"
                                                 Text="{Binding SourceImpedanceOhms, TargetNullValue=''}" />
                                        <Slider Minimum="1"
                                                Maximum="3"
                                                Value="{Binding ImpedanceLog}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Source impedance slider" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding ImpedanceDefaultNote}"
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="Panel connector" Style="{StaticResource InspectorLabel}" />
                                    <ComboBox AutomationProperties.Name="Panel connector"
                                              ItemsSource="{Binding ConnectorChoiceList}"
                                              SelectedItem="{Binding SelectedPortConnector}"
                                              DisplayMemberPath="Label" />
                                    <TextBlock Text="{Binding PortConnectorDefaultNote}"
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="Noise RMS (mV)" Style="{StaticResource InspectorLabel}" />
                                    <DockPanel>
                                        <TextBox DockPanel.Dock="Right"
                                                 Width="64"
                                                 AutomationProperties.Name="Noise RMS"
                                                 Text="{Binding NoiseRms, TargetNullValue=''}" />
                                        <Slider Minimum="0"
                                                Maximum="20"
                                                Value="{Binding NoiseSlider}"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Noise RMS slider" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding NoiseDefaultNote}"
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="Averaging (sweeps)" Style="{StaticResource InspectorLabel}" />
                                    <ComboBox ItemsSource="{Binding AveragingOptions}"
                                              SelectedItem="{Binding AveragingSweeps}" />
                                    <TextBlock Text="Sweep" Style="{StaticResource InspectorLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Normal"
                                                     Foreground="#EEE"
                                                     Margin="0,0,14,0"
                                                     IsChecked="{Binding IsNormalSweep}"
                                                     AutomationProperties.AutomationId="SweepNormal" />
                                        <RadioButton Content="One shot"
                                                     Foreground="#EEE"
                                                     IsChecked="{Binding OneShot}"
                                                     AutomationProperties.AutomationId="SweepOneShot" />
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding IsNormalSweep, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Noise refresh (per second)" Style="{StaticResource InspectorLabel}" />
                                        <DockPanel>
                                            <TextBox DockPanel.Dock="Right"
                                                     Width="64"
                                                     AutomationProperties.Name="Noise refresh rate"
                                                     Text="{Binding NoiseRefreshHz}" />
                                            <Slider Minimum="0.5"
                                                    Maximum="30"
                                                    Value="{Binding NoiseRefreshHz}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="Noise refresh rate slider" />
                                        </DockPanel>
                                    </StackPanel>
                                    <Button Content="New shot"
                                            HorizontalAlignment="Left"
                                            Margin="0,6,0,0"
                                            Padding="10,2"
                                            Command="{Binding NewShotCommand}"
                                            Visibility="{Binding OneShot, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.AutomationId="NewShotButton" />
                                    <TextBlock Text="Noise only: Normal re-rolls it like a free-running sweep, One shot freezes a single acquisition."
                                               Style="{StaticResource InspectorNote}" />
                                    <TextBlock Text="Clear a box to return to the preset default. Select a node to edit it here."
                                               Style="{StaticResource InspectorNote}" />
                                </StackPanel>
                            </DataTemplate>

                        </ContentControl.Resources>
                    </ContentControl>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
    </DockPanel>
</Window>
