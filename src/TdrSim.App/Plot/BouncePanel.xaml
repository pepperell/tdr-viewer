<UserControl x:Class="TdrSim.App.Plot.BouncePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="7*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- what the lattice idealizes -->
        <Border Grid.Row="0" Background="#333337" Padding="8,3">
            <TextBlock Text="{Binding Caption}"
                       Foreground="#E2B93B"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"
                       AutomationProperties.AutomationId="BounceCaption" />
        </Border>

        <!-- simulated rho + lattice staircase, then the lattice itself, on one time axis -->
        <scottplot:WpfPlot x:Name="TracePlot" Grid.Row="1" />
        <scottplot:WpfPlot x:Name="LatticePlot" Grid.Row="2" />

        <Border Grid.Row="3" Background="#252526" Padding="8,2" MinHeight="20">
            <TextBlock Text="{Binding HoverReadout}"
                       Foreground="#CCC"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- non-chain / nothing to show -->
        <Border Grid.Row="0"
                Grid.RowSpan="4"
                Background="#2D2D30"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Message}"
                       Foreground="#CCC"
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       MaxWidth="560"
                       Margin="16,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.AutomationId="BounceMessage" />
        </Border>
    </Grid>
</UserControl>
