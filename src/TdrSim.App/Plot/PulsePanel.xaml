<UserControl x:Class="TdrSim.App.Plot.PulsePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <UserControl.Resources>
        <Style x:Key="BarLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,3,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="BarBox" TargetType="TextBox">
            <Setter Property="Width" Value="46" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- stimulus + view controls -->
        <Border Grid.Row="0" Background="#333337" Padding="6,3">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="probe:" Style="{StaticResource BarLabel}" Margin="2,0,3,0" />
                    <ComboBox Width="180"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Probes}"
                              SelectedItem="{Binding SelectedProbe}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Pulse probe" />
                    <TextBlock Text="rise (ps):" Style="{StaticResource BarLabel}" />
                    <Slider Width="78"
                            Minimum="1"
                            Maximum="3.69897"
                            Value="{Binding RiseLog}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Rise slider" />
                    <TextBox Style="{StaticResource BarBox}" Text="{Binding RiseTimePs}" Margin="3,0,0,0" />
                    <TextBlock Text="fall (ps):" Style="{StaticResource BarLabel}" />
                    <Slider Width="78"
                            Minimum="1"
                            Maximum="3.69897"
                            Value="{Binding FallLog}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Fall slider" />
                    <TextBox Style="{StaticResource BarBox}" Text="{Binding FallTimePs}" Margin="3,0,0,0" />
                    <TextBlock Text="rate (MHz):" Style="{StaticResource BarLabel}" />
                    <Slider Width="78"
                            Minimum="-2"
                            Maximum="3"
                            Value="{Binding RateLog}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Rate slider" />
                    <TextBox Style="{StaticResource BarBox}"
                             AutomationProperties.Name="Pulse rate"
                             Text="{Binding RateMegahertz}"
                             Margin="3,0,0,0" />
                    <TextBlock Text="duty (%):" Style="{StaticResource BarLabel}" />
                    <Slider Width="64"
                            Minimum="1"
                            Maximum="99"
                            Value="{Binding DutySlider}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Duty slider" />
                    <TextBox Style="{StaticResource BarBox}" Width="34" Text="{Binding DutyPercent}" Margin="3,0,0,0" />
                    <TextBlock Text="pulses:" Style="{StaticResource BarLabel}" />
                    <ComboBox Width="46"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding PulseCountOptions}"
                              SelectedItem="{Binding PulsesDisplayed}"
                              AutomationProperties.Name="Pulses displayed" />
                </StackPanel>
                <TextBlock Text="{Binding Info}"
                           Foreground="#AAA"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="12,0,4,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <scottplot:WpfPlot x:Name="ThePlot" Grid.Row="1" />
    </Grid>
</UserControl>
